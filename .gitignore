```gitignore
# Virtual Environment
.venv/
venv/

# IntelliJ IDEA / PyCharm
.idea/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Environment variables
.env

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# VS Code (optional)
.vscode/

# Pytest
.pytest_cache/

# Coverage
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/
```
